USECLASS BME280I2,CKNJ16
USEGRAPHIC

A=$76
BME280I2::INIT(A)

K=NEW(CKNJ16,"UTF-8")

DO
  BME280I2::GETDATA()
  POINT 0, 0
  K.GPRT(SPRINTF$("温度：%3.1f℃",BME280I2::TEMP#),7,8)
  POINT 0,16
  K.GPRT(SPRINTF$("湿度：%3.1f％",BME280I2::HUMI#),7,8)
  POINT 0,32
  K.GPRT(SPRINTF$("気圧：%4.0fhPa",BME280I2::PRESS#),7,8)
  
  WAIT 60 * 5
LOOP

END
